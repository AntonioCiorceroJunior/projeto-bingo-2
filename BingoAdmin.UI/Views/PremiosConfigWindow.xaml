<Window x:Class="BingoAdmin.UI.Views.PremiosConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuração de Prêmios" Height="450" Width="600" WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/> <!-- Tie Breaker Config -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Prêmios da Rodada" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,0,0,10">
             <TextBlock Text="Critério de Desempate:" FontWeight="SemiBold"/>
             <ComboBox x:Name="CmbModoDisputa" Margin="0,5,0,0" SelectedIndex="0">
                 <ComboBoxItem Content="Distribuir (Perdedor leva prêmio seguinte)" Tag="0"/>
                 <ComboBoxItem Content="Eliminar (Perdedor sai da disputa desse prêmio)" Tag="1"/>
             </ComboBox>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="GridPremios" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ordem" Binding="{Binding Ordem}" Width="60"/>
                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                <DataGridTextColumn Header="Valor" Binding="{Binding Valor}" Width="100"/>
                
                <DataGridComboBoxColumn Header="Padrão do Prêmio" 
                                        SelectedValueBinding="{Binding PadraoId}" 
                                        DisplayMemberPath="Nome" 
                                        SelectedValuePath="Id"
                                        Width="200">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.PadroesDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="ComboBox">
                            <Setter Property="ItemsSource" Value="{Binding DataContext.PadroesDisponiveis, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>

                 <DataGridTemplateColumn Header="Ações" Width="80">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Remover" Click="RemoverPremio_Click"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Adicionar Prêmio" Click="AdicionarPremio_Click" Margin="0,0,10,0" Padding="10,5"/>
            <Button Content="Fechar" Click="Salvar_Click" Width="80" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>