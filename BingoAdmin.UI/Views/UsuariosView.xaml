<UserControl x:Class="BingoAdmin.UI.Views.UsuariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="10">
            <TextBlock Text="Gerenciamento de Usuários" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
            <TextBlock Text="Aprovar, bloquear ou estender licenças." Foreground="{DynamicResource SubTextBrush}"/>
            
            <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                <TextBlock Text="Buscar:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>
                <TextBox x:Name="SearchBox" Width="300" Height="30" Padding="5" VerticalContentAlignment="Center" KeyUp="SearchBox_KeyUp"/>
                <Button Content="Pesquisar" Width="100" Margin="10,0,0,0" Style="{DynamicResource PrimaryButtonStyle}" Click="SearchButton_Click"/>
            </StackPanel>
        </StackPanel>

        <DataGrid x:Name="UsuariosGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True" 
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  Background="White" RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                <DataGridTextColumn Header="E-mail" Binding="{Binding Email}" Width="150"/>
                <DataGridTextColumn Header="Telefone" Binding="{Binding Telefone}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding StatusAssinatura}" Width="100"/>
                <DataGridTextColumn Header="Validade" Binding="{Binding DataValidadeLicenca, StringFormat=dd/MM/yyyy HH:mm}" Width="140"/>
                
                <DataGridTemplateColumn Header="Ações" Width="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="ACESSAR" Margin="2" Padding="5,2" Background="#8e44ad" Foreground="White" FontWeight="Bold"
                                        Click="Impersonate_Click" Tag="{Binding Id}" ToolTip="Ver painel como este usuário"/>
                                <Button Content="30 Dias" Margin="2" Padding="5,2" Background="#2ecc71" Foreground="White" 
                                        Click="Add30Days_Click" Tag="{Binding Id}"/>
                                <Button Content="1 Dia" Margin="2" Padding="5,2" Background="#3498db" Foreground="White" 
                                        Click="Add1Day_Click" Tag="{Binding Id}"/>
                                <Button Content="Bloquear" Margin="2" Padding="5,2" Background="#e74c3c" Foreground="White" 
                                        Click="BlockUser_Click" Tag="{Binding Id}"/>
                                <Button Content="Excluir" Margin="2" Padding="5,2" Background="#8B0000" Foreground="White" 
                                        Click="DeleteUser_Click" Tag="{Binding Id}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>